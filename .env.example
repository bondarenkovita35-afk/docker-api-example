# =============================================================================
# EXEMPEL - inga riktiga hemligheter här.
# På servern: kopiera till api/.env och byt lösenordet:
#   sudo -u fastapi_service nano /home/fastapi_service/fastapi_app/api/.env
#   sudo chmod 600 /home/fastapi_service/fastapi_app/api/.env
# .env finns i .gitignore och får ALDRIG läggas i GitHub.
# =============================================================================
export DATABASE=fastapi_movies_db
export DB_USER=fastapi_user
export PASSWORD=byt-mot-ett-langt-slumpat-losenord
export DB_HOST=localhost
export DB_PORT=5432
export PYTHONPATH=/home/fastapi_service/fastapi_app/api

# --- Endast för Docker (VG), används inte i G-lösningen ---
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres123
# POSTGRES_DB=fastapi_movies_db
