# Plats på servern: /etc/fastapi_app/monitor.env  (sudo chmod 600)
# HEMLIG - webhook-URL:en får aldrig hamna i GitHub.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
DISK_THRESHOLD=80
CPU_THRESHOLD=80
MEM_THRESHOLD=90
SSH_FAIL_THRESHOLD=5
API_URL=http://localhost/status
REALERT_MINUTES=60
